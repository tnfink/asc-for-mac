+// getPGApplication() dereferences pgApp, which is NULL when there is no ParaGUI application
+// (e.g. in unittester). Taking the address of that reference is undefined behavior and lets
+// the compiler remove the null check below. Found by UndefinedBehaviorSanitizer.
+extern ASC_PG_App* pgApp;
+
 void AI::checkKeys ( void )
 {
-   ASC_PG_App* app = &getPGApplication();
+   ASC_PG_App* app = pgApp;
    if ( app )
       for ( int i = 0; i < 5; ++i )
          app->processEvent();
