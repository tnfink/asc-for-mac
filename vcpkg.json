{
  "$comment": "Libraries for the ASC core, following thirdparty/asc/vcpkg.json. The builtin-baseline pins all versions (vcpkg release 2026.10.16); scripts/build-core.sh checks out vcpkg at this commit. See doc/thirdparty.md.",
  "name": "asc-for-mac",
  "version-string": "2.6.99.0-mac0",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    "boost-algorithm",
    "boost-filesystem",
    "boost-heap",
    "boost-regex",
    "boost-smart-ptr",
    "boost-system",
    "boost-unordered",
    "bzip2",
    "expat",
    "fmt",
    "freetype",
    "libpng",
    "libsigcpp",
    "lua",
    "sdl2",
    {
      "name": "sdl2-image",
      "features": [
        "libjpeg-turbo"
      ]
    },
    {
      "name": "sdl2-mixer",
      "features": [
        "mpg123"
      ]
    },
    "physfs"
  ],
  "overrides": [
    {
      "$comment": "ASC needs libsigc++ 2.x (as in thirdparty/asc/vcpkg.json).",
      "name": "libsigcpp",
      "version": "2.10-3",
      "port-version": 2
    }
  ]
}
